# Локальный API: один процесс и одна активная сессия.
API__HOST=127.0.0.1
API__PORT=8000
API__WORKERS=1
API__MAX_SESSIONS=1
# Пустой список разрешает localhost и 127.0.0.1 с API__PORT.
API__ALLOWED_ORIGINS=[]
API__MAX_JSON_BYTES=16384
API__OUTBOUND_QUEUE_SIZE=128
API__MAX_RESPONSE_SEGMENTS=128
API__SEND_TIMEOUT_SECONDS=5
API__HANDSHAKE_TIMEOUT_SECONDS=10
API__SESSION_IDLE_TIMEOUT_SECONDS=300
API__CLOSE_TIMEOUT_SECONDS=2

# PCM16 little-endian mono. Частоты требуют реального преобразования сигнала.
AUDIO__INPUT_SAMPLE_RATE=16000
AUDIO__OUTPUT_SAMPLE_RATE=24000
AUDIO__CHANNELS=1
AUDIO__SAMPLE_WIDTH_BYTES=2
AUDIO__FRAME_MS=20
AUDIO__MAX_FRAME_MS=100
AUDIO__MAX_TURN_SECONDS=30
AUDIO__MAX_OUTPUT_BUFFER_SECONDS=2

# Режим ввода (PTT или автоматический) выбирается в браузере до подключения; ниже пороги VAD.
TURN__SPEECH_THRESHOLD=0.6
TURN__MIN_SPEECH_MS=96
TURN__BARGE_IN_SPEECH_MS=128
TURN__END_SILENCE_MS=640
TURN__PRE_ROLL_MS=320

# Базовые адреса сервисов в сети Docker Compose: распознавание речи, генерация ответа и озвучивание.
INFERENCE__MODE=cascade
INFERENCE__ASR_BASE_URL=http://asr:8000
INFERENCE__LLM_BASE_URL=http://llm:8000/v1
INFERENCE__TTS_BASE_URL=http://tts:8000
# Таймауты соединения, первого результата и паузы между частями ответа, секунды.
INFERENCE__CONNECT_TIMEOUT_SECONDS=5
INFERENCE__FIRST_RESPONSE_TIMEOUT_SECONDS=60
INFERENCE__IDLE_TIMEOUT_SECONDS=30
INFERENCE__MAX_RESPONSE_TOKENS=512
INFERENCE__MAX_HISTORY_TURNS=10
INFERENCE__MAX_PHRASE_CHARACTERS=200
INFERENCE__PHRASE_QUEUE_SIZE=2

# Необязательно: reference WAV внутри контейнера и точный текст записи без CV3 prefix.
# Оба пусты — используется стандартный референс CosyVoice3; для другого голоса задайте оба значения.
TTS_REFERENCE_WAV=
TTS_REFERENCE_TEXT=

LOGING_SETTINGS__CONSOLE_LEVEL=INFO
LOGING_SETTINGS__FILE_LEVEL=INFO
# Файл выключен по умолчанию. Для включения раскомментировать путь от корня.
# LOGING_SETTINGS__FILE_PATH=logs/switch-vox-core.log
LOGING_SETTINGS__ROTATION=10 MB
LOGING_SETTINGS__RETENTION=10 days

# Уровень фоновых журналов ASR, TTS и подготовки моделей.
RUNTIME_LOG_LEVEL=INFO
